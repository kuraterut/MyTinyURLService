<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1" author="kuraterut">
        <createTable tableName="tiny_url">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="original_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="short_code" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="alias" type="VARCHAR(255)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="kuraterut">
        <createIndex tableName="tiny_url" indexName="idx_tiny_url_short_code">
            <column name="short_code"/>
        </createIndex>

        <createIndex tableName="tiny_url" indexName="idx_tiny_url_alias">
            <column name="alias"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>